NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/samarth
JWT_SECRET=your_jwt_secret_key_here  
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.7-flash
GEMINI_REQUEST_TIMEOUT_MS=30000
GEMINI_MAX_ATTEMPTS=3
# Optional NeuroBot OpenAI-compatible provider. Uses POST {URL} with
# Authorization: Bearer {API_KEY} and a model/messages JSON body.
NEUROBOT_INFERENCE_URL=
NEUROBOT_API_KEY=
NEUROBOT_MODEL=